{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PassBuildInstanceRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::YOUR_ACCOUNT_ID:role/packer-build-ssm",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ValidateBuildInstanceProfile",
      "Effect": "Allow",
      "Action": "iam:GetInstanceProfile",
      "Resource": "arn:aws:iam::YOUR_ACCOUNT_ID:instance-profile/packer-build-ssm"
    }
  ]
}
